#!/usr/bin/env sh
# Git LFS installs its own hook at .git/hooks/pre-push, but core.hooksPath
# points at .husky/_, so git never runs it. Without this delegation, pushing a
# commit that touches an LFS-tracked file uploads no objects and the remote
# rejects it with GH008 ("unknown Git LFS object"), which reads as a server
# problem rather than a missing hook.
#
# test-data/telemetry/ holds two LFS files -- the iRacing and LMU capture tapes
# -- so this affects anyone who adds or changes one.
git lfs pre-push "$@"
